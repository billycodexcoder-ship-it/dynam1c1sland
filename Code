        if (activeStatus != StatusType.MUSIC) extended = false;
        extendingAnim.update(extended && activeStatus == StatusType.MUSIC ? 1f : 0f);

        notificationStateAnim.update(activeStatus == StatusType.NOTIFICATION ? 1 : 0);
        pvpStateAnim.update(activeStatus == StatusType.PVP ? 1 : 0);
        blinkStateAnim.update(activeStatus == StatusType.BLINK ? 1 : 0);
        eventStateAnim.update(activeStatus == StatusType.EVENT ? 1 : 0);
        mineStateAnim.update(activeStatus == StatusType.MINE ? 1 : 0);
        mediaStateAnim.update(activeStatus == StatusType.MUSIC ? 1 : 0);
        defaultStateAnim.update(activeStatus == StatusType.DEFAULT ? 1 : 0);

        Font textFont = Fonts.MEDIUM.getFont(7);
        float widthTarget;
        float heightTarget = 15f;

        switch (activeStatus) {
            case NOTIFICATION -> {
                String text = activeModuleNotification == null ? " " : activeModuleNotification.text;
                widthTarget = 22f + textFont.width(text); // TODO тут изменять если надо, ширина при уведомлении // 28 было, щас хз
                targetDisplayText = text;
                borderRadiusAnim.update(6f);
            }
            case PVP -> {
                String timerText = getPvpTimerSeconds() + "s";
                String statusText = "Вы в PVP режиме";
                widthTarget = computeTimerStatusWidth(statusText, timerText);
                targetDisplayText = statusText;
                borderRadiusAnim.update(6f);
            }
            case BLINK -> {
                widthTarget = 86f;
                targetDisplayText = "Blink";
                borderRadiusAnim.update(6f);
            }
            case EVENT -> {
                String statusText = eventText.isEmpty() ? "Событие" : eventText;
                String timerText = eventTimeText.isEmpty() ? "0:00" : eventTimeText;
                widthTarget = computeTimerStatusWidth(statusText, timerText);
                targetDisplayText = statusText;
                borderRadiusAnim.update(6f);
            }
            case MINE -> {
                String statusText = mineType.isEmpty() ? "Шахта" : mineType;
                String timerText = mineTimeText.isEmpty() ? "0:00" : mineTimeText;

                // TODO уменьшение островка для шахты (правая часть)
                float timeWidth = Fonts.MEDIUM.getFont(6).width(timerText);
                float textWidth = Fonts.MEDIUM.getFont(7).width(statusText);
                widthTarget = 19.0f + textWidth + timeWidth;   // TODO воу вот это да, сделали отдельно для шахты чтобы было красиво

                targetDisplayText = statusText;
                borderRadiusAnim.update(6f);
            }
            case MUSIC -> {
                String fullTrack = trackName + (artistsText != null && !artistsText.isEmpty() ? " - " + artistsText : "");
                targetDisplayText = fullTrack;
                float compactWidth = Math.min(32.0f + textFont.width(trackName), 100.0f);
                widthTarget = extended ? 164f : Math.max(48f, compactWidth);
                heightTarget = extended ? (showLyrics ? 125f : 80f) : 15f;
                borderRadiusAnim.update(7f + 11f * extendingAnim.getValue());
            }
            default -> {
                targetDisplayText = "Rockstar"; // TODO тут изменять если надо, правая сторона
                widthTarget = 22f + textFont.width("Rockstar");
                borderRadiusAnim.update(6f);
