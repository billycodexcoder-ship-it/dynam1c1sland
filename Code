    private String makeGender(String parent) {
        if (parent == null || parent.isEmpty()) return "";
        String lower = parent.toLowerCase(Locale.ROOT);
        if (lower.endsWith("а") || lower.endsWith("a") || lower.endsWith("я")) return "а";
        if (lower.endsWith("ы") || lower.endsWith("и")) return "ы";
        if (lower.endsWith("y") || lower.endsWith("ю") || lower.endsWith("u")) return "о";
        return "";
    }

