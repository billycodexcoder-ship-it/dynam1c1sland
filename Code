    private StatusType resolveActiveStatus(boolean notification, boolean pvp, boolean blink, boolean event, boolean mine, boolean music) {
        if (notification) return StatusType.NOTIFICATION;
        if (pvp) return StatusType.PVP;
        if (blink) return StatusType.BLINK;
        if (event) return StatusType.EVENT;
        if (mine) return StatusType.MINE;
        if (music) return StatusType.MUSIC;
        return StatusType.DEFAULT;
    }

