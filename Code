    // TODO уведомления как в крякнутом рокстаре, новые сами сделаете
    private void drawNotificationStatus(CustomDrawContext ctx, float x, float y, float anim) {
        ModuleToggleNotification active = getActiveModuleNotification();
        if (active == null) return;
        Font font = Fonts.MEDIUM.getFont(7);

        for (ModuleToggleNotification notification : moduleNotifications) {
            notification.showing.update(notification == active);
            float showValue = notification.showing.getValue();
            if (showValue <= 0.01f) continue;

            ColorRGBA dotColor = notification.enabled ? new ColorRGBA(55, 255, 55, 255) : new ColorRGBA(255, 25, 25, 255);
            float offset = 10.0f * anim * showValue;

            drawRoundedRectForced(ctx, x - 6.0f + offset, y + 4.0f, 7.0f, 7.0f, BorderRadius.all(3.0f), dotColor.mulAlpha(showValue));
            ctx.drawText(font, notification.text, x + 25.0f - offset, y + 5.0f, Colors.getTextColor().mulAlpha(showValue));
        }
