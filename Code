    // TODO не полный скид, скорее затычка, надо будет анимку пофиксить и будет вам полный скид (просмотрено 23.02)
    private boolean updateBlinkData() {
        Blink blink = Blink.INSTANCE;
        if (blink == null || !blink.isEnabled()) {
            blinkTimeText = "";
            blinkPulse = false;
            blinkProgress = 0f;
            return false;
        }
        blinkPulse = blink.getPulse().isEnabled();
        if (!blinkPulse) {
            float seconds = blink.getTimer().getElapsedTime() / 1000f;
            blinkTimeText = formatSeconds(seconds) + " сек";
            blinkProgress = 0f;
        } else {
            float total = blink.getTime().getCurrent() * 50f;
            float remaining = Math.max(0f, total - blink.getTimer().getElapsedTime());
            float blinkWidth = 80.0f - Fonts.MEDIUM.getFont(7).width("Blink") - 14.0f;
            blinkProgress = Math.max(0f, Math.min(blinkWidth, blinkWidth * (remaining / total)));
            blinkTimeText = "";
        }
        return true;
    }

    private boolean updateEventData() {
        if (mc == null || mc.world == null || ServerHelper.INSTANCE == null) {
            eventText = "";
            eventTimeText = "";
            return false;
        }

        List<ServerHelper.ServerEvent> events = ServerHelper.INSTANCE.getServerEvents();
        if (events.isEmpty()) {
            eventText = "";
            eventTimeText = "";
            return false;
        }

        long now = System.currentTimeMillis();
        ServerHelper.ServerEvent active = null;
        for (ServerHelper.ServerEvent event : events) {
            if ((long) event.timeEnd() > now) {
                active = event;
                break;
            }
        }
        if (active == null) {
            eventText = "";
            eventTimeText = "";
            return false;
        }

        long timeOpenMs = (long) active.timeOpen();
        long timeEndMs = (long) active.timeEnd();
        long remainingMs = timeOpenMs > now ? timeOpenMs - now : timeEndMs - now;

        int totalSeconds = Math.max(0, (int) (remainingMs / 1000L));
        int min = totalSeconds / 60;
        int sec = totalSeconds % 60;

        eventTimeText = String.format("%d:%02d", min, sec);
        eventText = active.name();
        eventColor = getEventColor(eventText);
        return true;
    }

    // TODO на сколько знаю на хв шахты не определяются
    private boolean updateMineData() {
        if (mc == null || mc.world == null || mc.player == null) {
            mineType = "";
            mineTimeText = "";
            return false;
        }

        Vec3d center = Zenith.getInstance().getServerHandler().isHolyWorld()
                ? new Vec3d(23.0, 41.0, -156.0)
                : new Vec3d(-52.0, 87.0, 3.0);

        String time = "";
        String type = "";
        List<String> hwTypes = List.of("обычная", "редкая", "эпическая", "легендарная", "мифическая");

        List<ArmorStandEntity> nearbyStands = new ArrayList<>();
        for (Entity entity : mc.world.getEntities()) {
            if (entity instanceof ArmorStandEntity armorStand && nearArmorStand(armorStand, center))
                nearbyStands.add(armorStand);
        }

        nearbyStands.sort((a, b) -> Double.compare(b.getY(), a.getY()));

        for (int i = 0; i < nearbyStands.size(); i++) {
            ArmorStandEntity armorStand = nearbyStands.get(i);
            Text customName = armorStand.getCustomName();
            if (customName == null) continue;

            String name = customName.getString().trim();
            if (name.matches("\\d{1,2}:\\d{2}")) {
                time = name.replaceFirst("^0", "");
            } else if (name.contains("осталось:")) {
                int index = name.indexOf(':');
                if (index != -1 && index + 2 < name.length()) {
                    String timeStr = name.substring(index + 1).trim();
                    int minIndex = timeStr.indexOf(" мин.");
                    int secIndex = timeStr.indexOf(" сек.");
                    if (minIndex != -1 && secIndex != -1) {
                        int min = Integer.parseInt(timeStr.substring(0, minIndex).trim());
                        int sec = Integer.parseInt(timeStr.substring(minIndex + 5, secIndex).trim());
                        time = String.format("%d:%02d", min, sec);
                    }
                }
            } else if (name.startsWith("Следующая:")) {
                int index = name.indexOf(':');
                if (index != -1 && index + 2 < name.length())
                    type = name.substring(index + 1).trim();
            } else if (name.equals("Следующая шахта:") && i + 1 < nearbyStands.size()) {
                ArmorStandEntity nextStand = nearbyStands.get(i + 1);
                Text nextName = nextStand.getCustomName();
                if (nextName != null) {
                    String nextNameStr = nextName.getString().trim();
                    if (hwTypes.contains(nextNameStr.toLowerCase().trim()))
                        type = nextNameStr;
                }
            }

            if (!time.isEmpty() && !type.isEmpty()) break;
        }

        if (time.isEmpty() || type.isEmpty()) {
            mineType = "";
            mineTimeText = "";
            return false;
        }

        mineType = type;
        mineTimeText = time;
        mineColor = getMineColor(type);
        return true;
    }

    private boolean nearArmorStand(ArmorStandEntity a, Vec3d v) {
        return Math.abs(a.getX() - v.x) <= 2.0
                && Math.abs(a.getY() - v.y) <= 2.0
                && Math.abs(a.getZ() - v.z) <= 2.0;
    }

