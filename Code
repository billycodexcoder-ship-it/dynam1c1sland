        drawSettingItem(ctx, theme, "Жидкое стекло", liquidGlassEnabled, settingsPanelX, currentY,
                panelWidth, itemHeight, checkboxSize, padding, contentAlpha);

        ctx.getMatrices().pop();
    }

    private void drawSettingItem(CustomDrawContext ctx, Theme theme, String label, boolean enabled,
                                 float x, float y, float width, float height, float checkboxSize,
                                 float padding, float alpha) {
        ctx.drawText(Fonts.MEDIUM.getFont(9f), label,
                x + padding, y + (height - 9f) / 2f, theme.getWhite().mulAlpha(0.8f * alpha));

        float checkboxX = x + width - padding - checkboxSize;
        float checkboxY = y + (height - checkboxSize) / 2f;

        if (enabled) {
            ColorRGBA checkboxBg = new ColorRGBA(80, 200, 120, (int) (255 * alpha));
            ColorRGBA checkboxBorder = new ColorRGBA(60, 180, 100, (int) (255 * alpha));
            drawRoundedRectForced(ctx, checkboxX - 0.5f, checkboxY - 0.5f, checkboxSize + 1f, checkboxSize + 1f,
                    BorderRadius.all(3f), checkboxBorder);
            drawRoundedRectForced(ctx, checkboxX, checkboxY, checkboxSize, checkboxSize,
                    BorderRadius.all(2.5f), checkboxBg);
        } else {
            ColorRGBA checkboxBg = theme.getBackgroundColor().mulAlpha(0.6f * alpha);
            ColorRGBA checkboxBorder = theme.getColor().mulAlpha(0.3f * alpha);
            drawRoundedRectForced(ctx, checkboxX - 0.5f, checkboxY - 0.5f, checkboxSize + 1f, checkboxSize + 1f,
                    BorderRadius.all(3f), checkboxBorder);
            drawRoundedRectForced(ctx, checkboxX, checkboxY, checkboxSize, checkboxSize,
                    BorderRadius.all(2.5f), checkboxBg);
        }
    }

    private boolean handleSettingsClick(double mouseX, double mouseY) {
        if (settingsPanelAnimation.getValue() < 0.9f) return false;
        float panelWidth = 150f; // TODO и тут тоже
        float itemHeight = 18f;
        float padding = 8f;

        if (mouseX < settingsPanelX || mouseX > settingsPanelX + panelWidth
                || mouseY < settingsPanelY || mouseY > settingsPanelY + 256f) {
            settingsPanelOpen = false;
            return false;
        }

        float currentY = settingsPanelY + padding + 14f + 4f;

        if (isInBounds(mouseX, mouseY, settingsPanelX, currentY, panelWidth, itemHeight)) {
            showNotifications = !showNotifications; return true;
        }
        currentY += itemHeight;

        if (isInBounds(mouseX, mouseY, settingsPanelX, currentY, panelWidth, itemHeight)) {
            showPvp = !showPvp; return true;
        }
        currentY += itemHeight;

        if (isInBounds(mouseX, mouseY, settingsPanelX, currentY, panelWidth, itemHeight)) {
            showBlink = !showBlink; return true;
        }
        currentY += itemHeight;

        if (isInBounds(mouseX, mouseY, settingsPanelX, currentY, panelWidth, itemHeight)) {
            showEvent = !showEvent; return true;
        }
        currentY += itemHeight;

        if (isInBounds(mouseX, mouseY, settingsPanelX, currentY, panelWidth, itemHeight)) {
            showMine = !showMine; return true;
        }
        currentY += itemHeight;

        if (isInBounds(mouseX, mouseY, settingsPanelX, currentY, panelWidth, itemHeight)) {
            viewMode = viewMode == IslandViewMode.NEW ? IslandViewMode.OLD : IslandViewMode.NEW; return true;
        }
        currentY += itemHeight;

        if (isInBounds(mouseX, mouseY, settingsPanelX, currentY, panelWidth, itemHeight)) {
            liquidGlassEnabled = !liquidGlassEnabled; return true;
        }

        return true;
    }

    private boolean isInBounds(double mouseX, double mouseY, float x, float y, float width, float height) {
        return mouseX >= x && mouseX <= x + width && mouseY >= y && mouseY <= y + height;
    }

    /**
     * Обработка кликов мыши по островку.
     */
    public boolean handleMouseClick(float mouseX, float mouseY, int button, int action) {
        if (action != 1) return false;
        boolean islandHovered = isMouseOver(mouseX, mouseY);

        if (button == 0) {
            if (extended && activeStatus == StatusType.MUSIC) {
                if (handleMusicClick(mouseX, mouseY)) return true;
                if (!islandHovered) {
                    extended = false;
                    return true;
                }
                return true;
            }
            if (activeStatus == StatusType.MUSIC && islandHovered) {
                extended = true;
                return true;
            }
            if (settingsPanelOpen) {
                return handleSettingsClick(mouseX, mouseY);
            }
        }

        if (!(mc.currentScreen instanceof ChatScreen)) {
            return false;
        }

        if (button == 1 && islandHovered) {
            boolean opening = !settingsPanelOpen;
            settingsPanelOpen = opening;
            if (opening) rightClickGlintAnimation.setValue(0f);
            return true;
        }

        return false;
    }

    private boolean handleMusicClick(float mouseX, float mouseY) {
        if (!canShowMusicStatus() || activeSession == null) return false;

        float x = this.x;
        float y = this.y;
        float expHeight = showLyrics ? 125.0f : 80.0f;
        float controlY = y + expHeight - 25.0f * extendingAnim.getValue();

        float buttonStartX = x + (164f - 16f * 3 - 16f) / 2f;
        float previousX = buttonStartX;
        float pauseX = previousX + 24f;
        float nextX = pauseX + 24f;
        float lyricsX = x + 14.0f;
        float lyricsY = y + expHeight - 21.0f;

        if (isInBounds(mouseX, mouseY, previousX, controlY, 16.0f, 16.0f)) { controlPrevious(); return true; }
        if (isInBounds(mouseX, mouseY, pauseX, controlY, 16.0f, 16.0f)) { controlPlayPause(); return true; }
        if (isInBounds(mouseX, mouseY, nextX, controlY, 16.0f, 16.0f)) { controlNext(); return true; }

        if (!timedLyrics.isEmpty() && isInBounds(mouseX, mouseY, lyricsX, lyricsY, 8.0f, 8.0f)) {
            showLyrics = !showLyrics;
            return true;
        }

        return false;
    }

    private void controlPrevious() { if (activeSession != null) activeSession.previous(); }
    private void controlPlayPause() { if (activeSession != null) activeSession.playPause(); }
    private void controlNext() { if (activeSession != null) activeSession.next(); }

