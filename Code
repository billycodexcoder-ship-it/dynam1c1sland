    /**
     * Обновление плавных анимаций (бары, переход текста, play/pause, артист, HUD).
     */
    private void updateSmoothAnimations() {
        long currentTime = System.currentTimeMillis();
        if (lastRenderTime > 0) {
            deltaTime = (currentTime - lastRenderTime) / 1000f;
            deltaTime = Math.min(deltaTime, 0.033f);
        }
        lastRenderTime = currentTime;

        for (int i = 0; i < 3; i++) {
            currentBarHeights[i] = lerp(currentBarHeights[i], targetBarHeights[i], 8f * deltaTime);
        }

        if (isTextTransitioning) {
            textTransitionProgress += 4f * deltaTime;
            if (textTransitionProgress >= 1f) {
                textTransitionProgress = 1f;
                isTextTransitioning = false;
                previousText = "";
            }
        }

        pausingAnim.update(isPlaying ? 1.0f : 0.0f);

        // Артист: быстро показываем только в расширенном режиме
        boolean wantArtist = (activeStatus == StatusType.MUSIC && extended);
        artistAlphaAnim.update(wantArtist ? 1f : 0f);

        // HUD (время/инет): при расширении уходит "обратно"
        boolean hideHud = (activeStatus == StatusType.MUSIC && extended);
        hudAlphaAnim.update(hideHud ? 0f : 1f);
        hudSlideAnim.update(hideHud ? 1f : 0f);
    }

    private float lerp(float a, float b, float t) {
        if (t > 1) t = 1;
        if (t < 0) t = 0;
        return a + (b - a) * t;
    }

    /**
     * Основной метод отрисовки компонента.
     */
    @Override
    public void render(CustomDrawContext ctx) {
        if (mc == null) return;

        if (mediaPollTimer.finished(200)) {
            updateMediaInfo();
            mediaPollTimer.reset();
        }

        Theme theme = Zenith.getInstance().getThemeManager().getCurrentTheme();
        checkBossBars();
        updateAnimations();
        updateSmoothAnimations();

        float padding = isPvpModeActive ? 3f : 4f;
        boolean mainMenu = mc.currentScreen instanceof CustomTitleScreen;

        float currentWidth = (float) widthAnim.getValue();
        float currentHeight = (float) heightAnim.getValue();
        float currentBorderRadius = activeStatus == StatusType.MUSIC
                ? 7.0f + 11.0f * extendingAnim.getValue()
                : (float) borderRadiusAnim.getValue();

        float defaultAlpha = (float) defaultStateAnim.getValue();
        float mediaAlpha = (float) mediaStateAnim.getValue();
        float pvpAlpha = (float) pvpStateAnim.getValue();
        float notificationAlpha = (float) notificationStateAnim.getValue();
        float blinkAlpha = (float) blinkStateAnim.getValue();
        float eventAlpha = (float) eventStateAnim.getValue();
        float mineAlpha = (float) mineStateAnim.getValue();
        float barAlpha = (float) barAnim.getValue();

        float x = mc.getWindow().getScaledWidth() / 2f - currentWidth / 2f;
        float y = 7f;
        if (hasNonPvpBossBars && !isPvpModeActive) y += 19;

        this.x = x;
        this.y = y;
        this.width = currentWidth;
        this.height = currentHeight;

        ctx.pushMatrix();
        {
            ColorRGBA blurColor = ColorRGBA.BLACK.mulAlpha(1f);
            DrawUtil.drawBlurHudFixed(ctx.getMatrices(), x - 1, y - 0.5f, currentWidth + 2, currentHeight + 1,
                    21, BorderRadius.all(currentBorderRadius), blurColor);

            ColorRGBA islandBg = theme.getBackgroundColor().withAlpha(220);
            if (activeStatus == StatusType.MUSIC) islandBg = islandBg.mix(mediaColor, 0.2f);

            drawRoundedRectForced(ctx, x - 1, y - 0.5f, currentWidth + 2, currentHeight + 1,
                    BorderRadius.all(currentBorderRadius), islandBg);

            if (liquidGlassAnimation.getValue() <= 0.01f) {
                drawRightClickGlint(ctx, x - 1f, y - 0.5f, currentWidth + 2f, currentHeight + 1f, currentBorderRadius);
            }

            ctx.enableScissor((int) (x - 1), (int) (y - 1), (int) (x + currentWidth + 1), (int) (y + currentHeight + 1));
            if (defaultAlpha > 0.01f) drawDefaultStatus(ctx, x, y, defaultStateAnim.getValue());
            if (mineAlpha > 0.01f) {
                String text = mineType.isEmpty() ? "Шахта" : mineType;
                String timeText = mineTimeText.isEmpty() ? "0:00" : mineTimeText;
                drawTimerStatus(ctx, x, y, text, timeText, mineColor, mineStateAnim.getValue());
            }
            if (eventAlpha > 0.01f) {
                String text = eventText.isEmpty() ? "Событие" : eventText;
                String timeText = eventTimeText.isEmpty() ? "0:00" : eventTimeText;
                drawTimerStatus(ctx, x, y, text, timeText, eventColor, eventStateAnim.getValue());
            }
            if (blinkAlpha > 0.01f) drawBlinkStatus(ctx, x, y, blinkStateAnim.getValue());
            if (pvpAlpha > 0.01f) {
                drawPvpStatus(ctx, x, y, "Вы в PVP режиме", getPvpTimerSeconds(),
                        new ColorRGBA(185, 28, 28, 255), pvpStateAnim.getValue());
            }
            if (notificationAlpha > 0.01f) drawNotificationStatus(ctx, x, y, notificationStateAnim.getValue());
            if (mediaAlpha > 0.01f) drawMusicStatus(ctx, x, y, mediaStateAnim.getValue());
            ctx.disableScissor();

            if (!mainMenu) {
                float hudA = hudAlphaAnim.getValue();
                float hudSlide = hudSlideAnim.getValue();

                Font timeFont = Fonts.MEDIUM.getFont(7);
                String currentTimeStr = LocalTime.now().format(DateTimeFormatter.ofPattern("HH:mm"));
                float timeX = x - 1 - (padding * 3f) - timeFont.width(currentTimeStr) + 10.0f * hudSlide;
                float timeYOffset = isPvpModeActive ? 5.0f : 3.0f;

                ColorRGBA hudElementColor = resolveAdaptiveHudElementColor(theme, x, y).mulAlpha(hudA);

                ctx.drawText(timeFont, currentTimeStr,
                        timeX,
                        y + timeYOffset - (padding / 4f) + (timeFont.height() / 2f),
                        hudElementColor);

                renderInternetStatus(ctx, theme,
                        x + 8.0f * hudSlide,
                        y,
                        currentWidth,
                        currentHeight,
                        padding,
                        barAlpha * hudA,
                        hudElementColor);
            }

            settingsPanelAnimation.update(settingsPanelOpen);
            if (settingsPanelAnimation.getValue() > 0f) drawSettingsPanel(ctx, theme);
        }
        ctx.popMatrix();
    }

    private void drawRoundedRectForced(CustomDrawContext ctx, float x, float y, float width, float height, BorderRadius borderRadius, ColorRGBA color) {
        boolean prevSuppress = DrawUtil.isSuppressHudFill();
        DrawUtil.setSuppressHudFill(false);
        try { ctx.drawRoundedRect(x, y, width, height, borderRadius, color); }
        finally { DrawUtil.setSuppressHudFill(prevSuppress); }
    }

    private void drawRoundedRectForced(CustomDrawContext ctx, float x, float y, float width, float height, BorderRadius borderRadius, Gradient gradient) {
        boolean prevSuppress = DrawUtil.isSuppressHudFill();
        DrawUtil.setSuppressHudFill(false);
        try { ctx.drawRoundedRect(x, y, width, height, borderRadius, gradient); }
        finally { DrawUtil.setSuppressHudFill(prevSuppress); }
    }

    private void drawInternetBarForced(CustomDrawContext ctx, float x, float y, float width, float height, ColorRGBA color) {
        drawRoundedRectForced(ctx, x, y, width, height, BorderRadius.all(1f), color);
    }

