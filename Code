    private String generateFallbackUrl(String artist, String title) {
        String artistSlug = artist != null ? toSlug(artist) : "";
        String titleSlug = toSlug(title);
        if (artistSlug.isEmpty()) return "https://genius.com/" + titleSlug + "-lyrics";
        return "https://genius.com/" + artistSlug + "-" + titleSlug + "-lyrics";
    }

    private String toSlug(String s) {
        if (s == null || s.isEmpty()) return "";
        StringBuilder slug = new StringBuilder();
        for (char c : s.toCharArray()) {
            String mapped = transliterateCyrillic(c);
            if (mapped != null) {
                slug.append(mapped);
            } else if (Character.isLetterOrDigit(c)) {
                slug.append(Character.toLowerCase(c));
            } else if (c == ' ' || c == '-' || c == '_') {
                slug.append('-');
            }
        }
        return slug.toString().replaceAll("-+", "-").replaceAll("^-|-$", "");
    }

    private String transliterateCyrillic(char c) {
        return switch (c) {
            case 'а' -> "a";
            case 'б' -> "b";
            case 'в' -> "v";
            case 'г' -> "g";
            case 'д' -> "d";
            case 'е' -> "e";
            case 'ё' -> "yo";
            case 'ж' -> "zh";
            case 'з' -> "z";
            case 'и' -> "i";
            case 'й' -> "y";
            case 'к' -> "k";
            case 'л' -> "l";
            case 'м' -> "m";
            case 'н' -> "n";
            case 'о' -> "o";
            case 'п' -> "p";
            case 'р' -> "r";
            case 'с' -> "s";
            case 'т' -> "t";
            case 'у' -> "u";
            case 'ф' -> "f";
            case 'х' -> "kh";
            case 'ц' -> "ts";
            case 'ч' -> "ch";
            case 'ш' -> "sh";
            case 'щ' -> "sch";
            case 'ъ' -> "";
            case 'ы' -> "y";
            case 'ь' -> "";
            case 'э' -> "e";
            case 'ю' -> "yu";
            case 'я' -> "ya";
            default -> null;
        };
    }

    /**
     * Сохранение лирики в JSON-файл (для отладки/кеширования).
     */
    private void saveLyricsToJson(String trackId, String title, String artist, String rawLyrics, List<LyricLine> lyrics, String sourceUrl) {
        try {
            File dir = new File(mc.runDirectory, "zenith/lyrics_dump");
            if (!dir.exists()) dir.mkdirs();
            String safeName = trackId.replaceAll("[\\\\/:*?\"<>|]", "_");
            File file = new File(dir, safeName + ".json");

            JsonObject root = new JsonObject();
            root.addProperty("trackId", trackId);
            root.addProperty("title", title);
            root.addProperty("artist", artist != null ? artist : "");

            String url = (sourceUrl != null && !sourceUrl.isEmpty()) ? sourceUrl : generateFallbackUrl(artist, title);
            root.addProperty("sourceUrl", url);
            root.addProperty("rawText", rawLyrics != null ? rawLyrics : "");

            JsonArray timeArray = new JsonArray();
            for (LyricLine line : lyrics) {
                JsonObject lineObj = new JsonObject();
                long seconds = line.timeMs / 1000;
                long minutes = seconds / 60;
                long secs = seconds % 60;
                lineObj.addProperty("time", String.format("%02d:%02d", minutes, secs));
                lineObj.addProperty("text", line.text);
                timeArray.add(lineObj);
            }

            root.add("timedLyrics", timeArray);
            root.addProperty("PrintText", rawLyrics != null ? rawLyrics : "");

            try (FileWriter writer = new FileWriter(file)) {
                writer.write(root.toString());
            }
        } catch (IOException e) {
            System.err.println("[DynamicIsland] Failed to save lyrics JSON: " + e.getMessage());
        }
    }

    // -------------------------
    // Текстурный фильтр для “непиксельных” иконок
    // -------------------------
    private static void setLinearTextureFiltering(boolean linear) {
        int min = linear ? GL11.GL_LINEAR : GL11.GL_NEAREST;
        int mag = linear ? GL11.GL_LINEAR : GL11.GL_NEAREST;
        RenderSystem.texParameter(GL11.GL_TEXTURE_2D, GL11.GL_TEXTURE_MIN_FILTER, min);
        RenderSystem.texParameter(GL11.GL_TEXTURE_2D, GL11.GL_TEXTURE_MAG_FILTER, mag);
    }
