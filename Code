    /**
     * Асинхронная загрузка лирики через LyricsFetcher.
     * После получения парсим и проверяем валидность (количество строк, покрытие таймингами).
     */
    private void fetchLyricsAsync(String artist, String title, String trackId, long durationMs) {
        if (lyricsPolling.compareAndSet(false, true)) {
            lyricsExecutor.execute(() -> {
                LyricsFetcher.LyricsResult result = LyricsFetcher.fetchFromGeniusWithUrl(artist, title);
                final String fetched = result != null ? result.text() : null;
                final String url = result != null ? result.url() : "";

                final ParsedLyrics parsed = parseLyricsFull(fetched);

                if (mc != null) {
                    mc.execute(() -> {
                        if (trackId.equals(lastTrackId)) {
                            timedLyrics = parsed.lines;

                            boolean synced = parsed.synced;

                            // Проверяем покрытие таймингами (если synced)
                            if (synced && durationMs > 0 && !timedLyrics.isEmpty()) {
                                long lastTs = timedLyrics.get(timedLyrics.size() - 1).timeMs;
                                float coverage = Math.min(1f, (float) lastTs / (float) durationMs);

                                if (coverage < MIN_SYNC_COVERAGE) {
                                    if (BAD_SYNC_FALLBACK_TO_UNSYNCED) {
                                        synced = false; // покажем как unsynced (со скроллом)
                                    } else {
                                        timedLyrics = new ArrayList<>();
                                        synced = false;
                                    }
                                }
                            }

                            lyricsSynced = synced;
                            lyricsScrollIndex = 0;

                            currentLyricIndex = -1;
                            targetLyricIndex = -1;
                            oldLyricIndex = -1;
                            lyricsAnimating = false;
                            lyricsCurrentShift = 0f;
                            lyricsWindowBaseIndex = -1;

                            showLyrics = !timedLyrics.isEmpty();
                            currentLyricsUrl = url;

                            saveLyricsToJson(trackId, title, artist, fetched, timedLyrics, url);
                        }
                        lyricsPolling.set(false);
                    });
                } else {
                    lyricsPolling.set(false);
                }
            });
        }
    }

    // -------------------------
    // ЛИРИКА: парсим и сохраняем "synced/unsynced"
    // -------------------------
    private static class ParsedLyrics {
        final List<LyricLine> lines;
        final boolean synced;
        ParsedLyrics(List<LyricLine> lines, boolean synced) {
            this.lines = lines;
            this.synced = synced;
        }
    }

    /**
     * Парсит сырой текст лирики.
     * Если есть хотя бы одна строка с таймкодом и хотя бы одна без таймкода (после таймкодов) —
     * весь текст считается несинхронным (unsynced), порядок строк сохраняется, таймкоды обнуляются.
     * Если все строки имеют таймкоды — синхронная, сортируем по времени.
     * Если ни одной строки с таймкодом — несинхронная.
     */
    private ParsedLyrics parseLyricsFull(String raw) {
        if (raw == null || raw.isEmpty()) return new ParsedLyrics(new ArrayList<>(), false);

        // Проверка минимального количества непустых строк
        int nonEmpty = 0;
        for (String l : raw.split("\\n")) {
            if (!l.trim().isEmpty()) nonEmpty++;
        }
        if (nonEmpty < MIN_LYRIC_LINES) {
            return new ParsedLyrics(new ArrayList<>(), false);
        }

        Pattern timePattern = Pattern.compile("\\[(\\d{2}):(\\d{2})\\.(\\d{2})\\]");
        String[] lines = raw.split("\\n");

        List<LyricLine> result = new ArrayList<>();
        boolean hasTimestampLine = false;
        boolean hasUntimedLineAfterTimestamp = false;
        boolean timestampSeen = false;

        for (String line : lines) {
            Matcher m = timePattern.matcher(line);
            if (m.find()) {
                timestampSeen = true;
                hasTimestampLine = true;
                int minutes = Integer.parseInt(m.group(1));
                int seconds = Integer.parseInt(m.group(2));
                int millis = Integer.parseInt(m.group(3));
                long timeMs = (minutes * 60L + seconds) * 1000L + millis * 10L;
                String text = line.substring(m.end()).trim();
                if (!text.isEmpty()) {
                    result.add(new LyricLine(timeMs, text));
                }
            } else {
                // Строка без таймкода
                String trimmed = line.trim();
                if (!trimmed.isEmpty()) {
                    if (timestampSeen) {
                        // Если уже были таймкоды и теперь встретилась строка без — помечаем как смешанный случай
                        hasUntimedLineAfterTimestamp = true;
                    }
                    result.add(new LyricLine(0L, trimmed));
                }
            }
        }

        if (result.isEmpty()) return new ParsedLyrics(new ArrayList<>(), false);

        // Случай 1: нет ни одной строки с таймкодом -> unsynced
        if (!hasTimestampLine) {
            return new ParsedLyrics(result, false);
        }

        // Случай 2: есть строки с таймкодами И есть строки без таймкодов после таймкодов -> unsynced (сохраняем порядок)
        if (hasUntimedLineAfterTimestamp) {
            // Обнуляем все таймкоды, чтобы не синхронизировать
            for (LyricLine ll : result) {
                ll.timeMs = 0L;
            }
            return new ParsedLyrics(result, false);
        }

        // Случай 3: все строки имеют таймкоды -> синхронная лирика
        result.sort(Comparator.comparingLong(a -> a.timeMs));
        return new ParsedLyrics(result, true);
    }

    private String truncateToWidth(String text, float maxWidth, Font font) {
        if (font.width(text) <= maxWidth) return text;
        String ellipsis = "...";
        float ellipsisWidth = font.width(ellipsis);
        for (int i = text.length(); i >= 0; i--) {
            String sub = text.substring(0, i);
            if (font.width(sub) + ellipsisWidth <= maxWidth) {
                return sub + ellipsis;
            }
        }
        return text;
    }

