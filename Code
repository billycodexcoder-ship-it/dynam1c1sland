    private static String formatMediaTime(long totalSeconds) {
        long safe = Math.max(0L, totalSeconds);
        long minutes = safe / 60L;
        long seconds = safe % 60L;
        return String.format("%d:%02d", minutes, seconds);
    }

    private ColorRGBA resolveAdaptiveHudElementColor(Theme theme, float x, float y) {
        if (viewMode != IslandViewMode.NEW) {
            adaptiveHudColor = theme.getWhite();
            adaptiveHudColorAnimation.setValue(1f);
            return adaptiveHudColor;
        }

        if (adaptiveHudColorTimer.finished(500L)) {
            float pixelX = mc.getWindow().getWidth() / 2.0f;
            float pixelY = mc.getWindow().getHeight() - (y + 5.0f);
            ColorRGBA pixel = ColorRGBA.fromPixel(pixelX, pixelY);
            adaptiveUseDark = (pixel.getRed() + pixel.getGreen() + pixel.getBlue()) / 3.0f > 70.0f;
            adaptiveHudColorTimer.reset();
        }

        adaptiveHudColorAnimation.update(adaptiveUseDark ? 0f : 1f);
        adaptiveHudColor = ColorRGBA.lerp(ColorRGBA.BLACK, ColorRGBA.WHITE, adaptiveHudColorAnimation.getValue());
        return adaptiveHudColor;
    }

    private void drawRightClickGlint(CustomDrawContext ctx, float x, float y, float width, float height, float borderRadius) {
        float glint = rightClickGlintAnimation.update(1f);
        if (settingsPanelOpen && glint >= 0.999f) {
            rightClickGlintAnimation.setValue(0f);
            glint = 0f;
        }
        if (!settingsPanelOpen && glint >= 0.999f) return;

        float inv = 1.0f - glint;
        float sweepWidth = Math.max(18f, width * 0.38f);
        float travelStart = x;
        float travelEnd = x + Math.max(0f, width - sweepWidth);
        float currentX = travelStart + (travelEnd - travelStart) * glint;

        float fillAlpha = 0.16f * inv;
        float borderAlpha = 0.34f * inv;
        float bandAlpha = 0.42f * inv;
        float secondaryAlpha = 0.24f * inv;

        float radius = Math.max(4f, borderRadius);
        float bandRadius = Math.min(radius, Math.min(height, sweepWidth) * 0.5f);
        float secondaryWidth = sweepWidth * 0.55f;
        float secondaryRadius = Math.min(radius, Math.min(height, secondaryWidth) * 0.5f);

        drawRoundedRectForced(ctx, x, y, width, height, BorderRadius.all(radius), ColorRGBA.WHITE.mulAlpha(fillAlpha));
        ctx.drawRoundedBorder(x, y, width, height, 1.0f, BorderRadius.all(radius), ColorRGBA.WHITE.mulAlpha(borderAlpha));

        drawRoundedRectForced(ctx, currentX, y, sweepWidth, height, BorderRadius.all(bandRadius),
                Gradient.of(ColorRGBA.WHITE.mulAlpha(0f), ColorRGBA.WHITE.mulAlpha(bandAlpha * 0.25f),
                        ColorRGBA.WHITE.mulAlpha(bandAlpha), ColorRGBA.WHITE.mulAlpha(0f)));

        drawRoundedRectForced(ctx, currentX - sweepWidth * 0.45f, y, secondaryWidth, height, BorderRadius.all(secondaryRadius),
                Gradient.of(ColorRGBA.WHITE.mulAlpha(0f), ColorRGBA.WHITE.mulAlpha(secondaryAlpha * 0.2f),
                        ColorRGBA.WHITE.mulAlpha(secondaryAlpha), ColorRGBA.WHITE.mulAlpha(0f)));
    }

    private void renderInternetStatus(CustomDrawContext ctx, Theme theme, float x, float y, float width, float height,
                                      float padding, float barAlpha, ColorRGBA elementColor) {
        if (viewMode == IslandViewMode.NEW) {
            boolean hasPingInfo = mc.player != null && !mc.isInSingleplayer() && mc.player.networkHandler != null
                    && mc.player.networkHandler.getPlayerListEntry(mc.player.getUuid()) != null;

            if (hasPingInfo) {
                int ping = mc.player.networkHandler.getPlayerListEntry(mc.player.getUuid()).getLatency();
                int[] pingThresholds = new int[]{450, 300, 150, 75};

                float baseX = x + width + 8.5f;
                float baseY = y + 8.0f;
                float barWidth = 2.0f;
                float gap = 0.7f;

                for (int i = 0; i < 4; i++) {
                    float barHeight = 3.0f + i;
                    float barX = baseX + i * (barWidth + gap);
                    float barY = baseY - i;
                    drawInternetBarForced(ctx, barX, barY, barWidth, barHeight, elementColor.withAlpha(elementColor.getAlpha() * 0.2f));
                }

                for (int i = 0; i < 4; i++) {
                    if (ping < pingThresholds[i]) {
                        float barHeight = 3.0f + i;
                        float barX = baseX + i * (barWidth + gap);
                        float barY = baseY - i;
                        drawInternetBarForced(ctx, barX, barY, barWidth, barHeight, elementColor);
                    }
                }
            } else {
                ctx.drawTexture(Zenith.id("icons/airplane.png"), x + width + 8.0f, y + 3.5f, 8.0f, 8.0f, elementColor);
            }
            return;
        }

        float baseBarY = y + padding + (Fonts.ICONS.getFont(7).height() / 2f) - 5 + 1;
        float[] barYs = new float[3];
        for (int i = 0; i < 3; i++) barYs[i] = baseBarY + (10 - currentBarHeights[i]) / 2f;

        boolean hasActiveMusic = activeStatus == StatusType.MUSIC;
        if (hasActiveMusic && barAlpha > 0.01f) {
            ColorRGBA barColor = elementColor.mulAlpha(barAlpha);
            drawInternetBarForced(ctx, x + width + (padding * 3f), barYs[0], 3.5f, currentBarHeights[0], barColor);
            drawInternetBarForced(ctx, x + width + (padding * 3f) + 4, barYs[1], 3.5f, currentBarHeights[1], barColor);
            drawInternetBarForced(ctx, x + width + (padding * 3f) + 8, barYs[2], 3.5f, currentBarHeights[2], barColor);
        } else {
            drawInternetBarForced(ctx, x + width + (padding * 3f), baseBarY, 3.5f, 10f, elementColor);
            drawInternetBarForced(ctx, x + width + (padding * 3f) + 4, baseBarY + 2, 3.5f, 8f, elementColor);
            drawInternetBarForced(ctx, x + width + (padding * 3f) + 8, baseBarY + 3.5f, 3.5f, 6.5f, elementColor);
        }
    }

    /**
     * Отрисовка панели настроек (по правому клику).
     */
    private void drawSettingsPanel(CustomDrawContext ctx, Theme theme) {
        float panelWidth = 150f;
        float itemHeight = 18f;
        float padding = 8f;
        float checkboxSize = 12f;
        float animValue = settingsPanelAnimation.getValue();
        float alpha = animValue;

        settingsPanelX = this.x + this.width + 10f;
        settingsPanelY = this.y;

        ColorRGBA bgColor = theme.getBackgroundColor().mulAlpha(0.95f * alpha);
        ColorRGBA borderColor = theme.getColor().mulAlpha(0.3f * alpha);
        ColorRGBA dividerColor = theme.getColor().mulAlpha(0.15f * alpha);

        ctx.getMatrices().push();
        ctx.getMatrices().translate(settingsPanelX + panelWidth / 2f, settingsPanelY + 128f, 0f);
        ctx.getMatrices().scale(animValue, animValue, 1f);
        ctx.getMatrices().translate(-(settingsPanelX + panelWidth / 2f), -(settingsPanelY + 128f), 0f);

        float liquidAnim = liquidGlassAnimation.getValue();
        if (liquidAnim > 0.01f) {
            DrawUtil.drawBlurHudFixed(ctx.getMatrices(), settingsPanelX, settingsPanelY, panelWidth, 256f, 21,
                    BorderRadius.all(4f), ColorRGBA.WHITE.mulAlpha(liquidAnim));
            DrawUtil.drawLiquidRect(ctx.getMatrices(), settingsPanelX, settingsPanelY, panelWidth, 256f,
                    BorderRadius.all(4f), Interface.INSTANCE.getLiquidGlassColor().mulAlpha(liquidAnim),
                    2.0f, 25.0f, 0.5f, 1.0f, true, 0.5f, 0.02f);
        } else {
            DrawUtil.drawBlurHudFixed(ctx.getMatrices(), settingsPanelX, settingsPanelY, panelWidth, 256f, 21,
                    BorderRadius.all(4f), ColorRGBA.WHITE);
        }

        drawRoundedRectForced(ctx, settingsPanelX - 1, settingsPanelY - 1, panelWidth + 2, 256f + 2,
                BorderRadius.all(5f), borderColor);
        drawRoundedRectForced(ctx, settingsPanelX, settingsPanelY, panelWidth, 256f, BorderRadius.all(4f), bgColor);

        if (animValue < 0.3f) {
            ctx.getMatrices().pop();
            return;
        }
        float contentAlpha = (animValue - 0.3f) / 0.7f;

        String title = "Dynamic Island";
        float titleWidth = Fonts.MEDIUM.getFont(9f).width(title);
        ctx.drawText(Fonts.MEDIUM.getFont(9f), title,
                settingsPanelX + (panelWidth - titleWidth) / 2f, settingsPanelY + padding,
                theme.getWhite().mulAlpha(contentAlpha));

        float currentY = settingsPanelY + padding + 14f;
        drawRoundedRectForced(ctx, settingsPanelX + padding, currentY, panelWidth - padding * 2f, 1f,
                BorderRadius.ZERO, dividerColor.mulAlpha(contentAlpha));
        currentY += 4f;

        drawSettingItem(ctx, theme, "Уведомления", showNotifications, settingsPanelX, currentY, // TODO вау, тут поменять можно
                panelWidth, itemHeight, checkboxSize, padding, contentAlpha);
        currentY += itemHeight;

        drawSettingItem(ctx, theme, "PVP", showPvp, settingsPanelX, currentY,
                panelWidth, itemHeight, checkboxSize, padding, contentAlpha);
        currentY += itemHeight;

        drawSettingItem(ctx, theme, "Blink", showBlink, settingsPanelX, currentY,
                panelWidth, itemHeight, checkboxSize, padding, contentAlpha);
        currentY += itemHeight;

        drawSettingItem(ctx, theme, "Ивенты", showEvent, settingsPanelX, currentY,
                panelWidth, itemHeight, checkboxSize, padding, contentAlpha);
        currentY += itemHeight;

        drawSettingItem(ctx, theme, "Шахта", showMine, settingsPanelX, currentY,
                panelWidth, itemHeight, checkboxSize, padding, contentAlpha);
        currentY += itemHeight;

        drawSettingItem(ctx, theme, "New view", viewMode == IslandViewMode.NEW, settingsPanelX, currentY,
