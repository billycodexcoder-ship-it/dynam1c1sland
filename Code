    /**
     * Рендер жидкого стекла (размытие и специальный эффект) под островком.
     */
    @Override
    public void renderLiquidGlass(CustomDrawContext ctx) {
        float liquidAnim = liquidGlassAnimation.getValue();
        if (liquidAnim <= 0.01f || mc == null) return;

        checkBossBars();

        float currentWidth = (float) widthAnim.getValue();
        float currentHeight = (float) heightAnim.getValue();
        float currentBorderRadius = activeStatus == StatusType.MUSIC
                ? 7.0f + 11.0f * (float) extendingAnim.getValue()
                : Math.max(4f, (float) borderRadiusAnim.getValue());

        float drawX = mc.getWindow().getScaledWidth() / 2f - currentWidth / 2f - 1f;
        float drawY = 7f;
        if (hasNonPvpBossBars && !isPvpModeActive) drawY += 19f;
        drawY -= 0.5f;

        float drawW = currentWidth + 2f;
        float drawH = currentHeight + 1f;

        DrawUtil.drawBlurHudFixed(ctx.getMatrices(), drawX, drawY, drawW, drawH, 21f,
                BorderRadius.all(currentBorderRadius), ColorRGBA.WHITE.mulAlpha(liquidAnim));

        DrawUtil.drawLiquidRect(ctx.getMatrices(), drawX, drawY, drawW, drawH,
                BorderRadius.all(currentBorderRadius),
                Interface.INSTANCE.getLiquidGlassColor().mulAlpha(liquidAnim),
                2.0f, 25.0f, 0.5f, 1.0f, true, 0.5f, 0.02f);

        drawRightClickGlint(ctx, drawX, drawY, drawW, drawH, currentBorderRadius);
    }

    /**
     * Тиковый метод: обновление информации о медиа, боссбарах, анимациях и лирике.
     */
    @Override
    public void tick() {
        if (mc == null) return;

        boolean isChat = mc.currentScreen instanceof ChatScreen;
        if (!isChat && settingsPanelOpen) settingsPanelOpen = false;
        if (wasChatScreen && !isChat && extended && activeStatus == StatusType.MUSIC) extended = false;
        wasChatScreen = isChat;

        if (mediaPollTimer.finished(200)) {
            updateMediaInfo();
            mediaPollTimer.reset();
        }

        checkBossBars();
        liquidGlassAnimation.update(liquidGlassEnabled ? 1f : 0f);

        updateAnimations();

        // Синхронная анимация строк (только если есть таймкоды)
        if (activeStatus == StatusType.MUSIC && showLyrics && lyricsSynced && !timedLyrics.isEmpty()) {
            long pos = currentTimeMs;

            // пока не дошли до 1-й строки — активной нет
            long firstTime = timedLyrics.get(0).timeMs;
            int newIndex = (pos < firstTime) ? -1 : 0;

            if (newIndex != -1) {
                for (int i = timedLyrics.size() - 1; i >= 0; i--) {
                    if (pos >= timedLyrics.get(i).timeMs) {
                        newIndex = i;
                        break;
                    }
                }
            }

            if (newIndex != targetLyricIndex) {
                if (!lyricsAnimating) {
                    oldLyricIndex = currentLyricIndex;
                    lyricsWindowBaseIndex = oldLyricIndex;
                }
                targetLyricIndex = newIndex;

                if (!lyricsAnimating && targetLyricIndex != currentLyricIndex) {
                    int from = (oldLyricIndex < 0 ? 0 : oldLyricIndex);
                    int to = (targetLyricIndex < 0 ? 0 : targetLyricIndex);

                    int deltaIndex = to - from;
                    float startShift = -deltaIndex * LYRIC_LINE_HEIGHT;

                    lyricsShiftAnim.setValue(startShift);
                    lyricsShiftAnim.setDuration(170);
                    lyricsShiftAnim.update(0f);

                    lyricsAnimating = true;
                    lyricsCurrentShift = startShift;
                }
            }

            if (lyricsAnimating) {
                lyricsShiftAnim.update(1f);
                lyricsCurrentShift = lyricsShiftAnim.getValue();
                if (Math.abs(lyricsCurrentShift) < 0.01f) {
                    currentLyricIndex = targetLyricIndex;
                    lyricsAnimating = false;
                    lyricsCurrentShift = 0f;
                    lyricsWindowBaseIndex = -1;
                }
            }
        }
    }

    /**
     * Опрос текущего медиа-плеера (через MediaPlayerInfo).
     * Получаем название трека, исполнителя, обложку, позицию, длительность.
     */
    private void updateMediaInfo() {
        if (isWindowsNativeMediaDisabled()) {
            if (!mediaProviderDisabledLogged) {
                mediaProviderDisabledLogged = true;
                System.err.println("[DynamicIsland] Windows native media polling disabled.");
            }
            clearData();
            return;
        }

        if (polling.compareAndSet(false, true)) {
            executor.execute(() -> {
                try {
                    if (MediaPlayerInfo.INSTANCE == null) {
                        if (mc != null) mc.execute(this::clearData);
                        return;
                    }

                    final IMediaSession[] localSession = new IMediaSession[1];
                    final MediaInfo[] localInfo = new MediaInfo[1];
                    final byte[][] localCover = new byte[1][];
                    final int[] localCoverHash = new int[1];

                    try {
                        var sessions = MediaPlayerInfo.INSTANCE.getMediaSessions();
                        try { sessions.clear(); } catch (Throwable ignored) {}
                        sessions = MediaPlayerInfo.INSTANCE.getMediaSessions();

                        localSession[0] = sessions.stream()
                                .filter(s -> s != null && s.getMedia() != null)
                                .filter(s -> {
                                    MediaInfo media = s.getMedia();
                                    return media != null
                                            && media.getArtist() != null && !media.getArtist().isEmpty()
                                            && media.getTitle() != null && !media.getTitle().isEmpty();
                                })
                                .findFirst().orElse(null);

                        if (localSession[0] != null) localInfo[0] = localSession[0].getMedia();
                    } catch (Exception e) {
                        if (mc != null) mc.execute(this::clearData);
                        return;
                    }

                    if (localSession[0] != null && localInfo[0] != null && !localInfo[0].getTitle().isEmpty()) {
                        final String newTrackName = localInfo[0].getTitle();
                        final String newArtistsText = (localInfo[0].getArtist() != null && !localInfo[0].getArtist().isEmpty())
                                ? localInfo[0].getArtist() : null;

                        // *** КЛЮЧЕВОЕ ИЗМЕНЕНИЕ: переводим секунды в миллисекунды ***
                        final long newPosSec = localInfo[0].getPosition();
                        final long newDurSec = localInfo[0].getDuration();
                        final long newPosMs = Math.max(0L, newPosSec * 1000L);
                        final long newDurMs = newDurSec > 0 ? newDurSec * 1000L : 1L;
                        final boolean newPlaying = localInfo[0].isPlaying();

                        try {
                            localCover[0] = localInfo[0].getArtworkPng();
                            if (localCover[0] != null && localCover[0].length > 0)
                                localCoverHash[0] = Arrays.hashCode(localCover[0]);
                        } catch (Exception ignored) {}

                        if (mc != null) {
                            mc.execute(() -> {
                                activeSession = localSession[0];
                                trackName = newTrackName;
                                artistsText = newArtistsText;
                                totalTimeMs = newDurMs;
                                currentTimeMs = newPosMs;
                                isPlaying = newPlaying;

                                String currentTrackId = ((newArtistsText == null ? "" : newArtistsText) + " - " + newTrackName).trim();
                                if (!currentTrackId.equals(lastTrackId)) {
                                    lastTrackId = currentTrackId;

                                    // сброс лирики для нового трека
                                    timedLyrics.clear();
                                    lyricsSynced = false;
                                    lyricsScrollIndex = 0;

                                    currentLyricIndex = -1;
                                    targetLyricIndex = -1;
                                    oldLyricIndex = -1;
                                    lyricsAnimating = false;
                                    lyricsCurrentShift = 0f;
                                    lyricsWindowBaseIndex = -1;

                                    showLyrics = false;
                                    fetchLyricsAsync(newArtistsText, newTrackName, currentTrackId, newDurMs);

                                    startTextTransition(currentDisplayText, newTrackName);
                                }

                                // Обновление обложки
                                if (localCover[0] == null || localCover[0].length == 0) {
                                    clearCoverTexture();
                                    coverHash = 0;
                                } else if (localCoverHash[0] != coverHash) {
                                    updateCoverTexture(localCover[0]);
                                    coverHash = localCoverHash[0];
                                }
                            });
                        }
                    } else {
                        if (mc != null) mc.execute(this::clearData);
                    }
                } catch (Throwable e) {
                    System.err.println("Error in media polling: " + e.getMessage());
                    if (mc != null) mc.execute(this::clearData);
                } finally {
                    polling.set(false);
                }
            });
        }
    }

    private boolean isWindowsNativeMediaDisabled() {
        return Boolean.getBoolean("zenith.media.disableWindowsNative");
    }

    private void clearCoverTexture() {
        if (coverTexture != null) coverTexture = null;
        coverHash = 0;
    }

    private void updateCoverTexture(byte[] coverData) {
        clearCoverTexture();
        if (coverData != null && coverData.length > 0 && mc != null) {
            try {
                coverTexture = new Texture(artwork);
                Render2DUtil.registerTexture(coverTexture, coverData);
                mediaColor = extractMediaColor(coverData);
            } catch (Exception e) {
                coverTexture = null;
                mediaColor = ColorRGBA.WHITE;
            }
        }
    }

    /**
     * Извлечение доминирующего цвета из обложки для использования в фоне островка.
     */
    private ColorRGBA extractMediaColor(byte[] coverData) {
        try {
            BufferedImage image = ImageIO.read(new ByteArrayInputStream(coverData));
            if (image == null) return ColorRGBA.WHITE;

            long r = 0, g = 0, b = 0, count = 0;
            int stepX = Math.max(1, image.getWidth() / 24);
            int stepY = Math.max(1, image.getHeight() / 24);

            for (int y = 0; y < image.getHeight(); y += stepY) {
                for (int x = 0; x < image.getWidth(); x += stepX) {
                    int argb = image.getRGB(x, y);
                    int alpha = (argb >>> 24) & 0xFF;
                    if (alpha < 16) continue;

                    r += (argb >>> 16) & 0xFF;
                    g += (argb >>> 8) & 0xFF;
                    b += argb & 0xFF;
                    count++;
                }
            }

            if (count == 0) return ColorRGBA.WHITE;

            int rr = (int) (r / count);
            int gg = (int) (g / count);
            int bb = (int) (b / count);

            ColorRGBA avg = new ColorRGBA(rr, gg, bb, 255);
            return avg.mix(ColorRGBA.WHITE, 0.15f);
        } catch (Exception ignored) {
            return ColorRGBA.WHITE;
        }
    }

