    private void drawPvpStatus(CustomDrawContext ctx, float x, float y, String text, int seconds,
                               ColorRGBA color, float anim) {
        Font timeFont = Fonts.MEDIUM.getFont(6);
        Font textFont = Fonts.MEDIUM.getFont(7);

        int safeSeconds = Math.max(0, seconds);
        String suffix = "s";
        float timeX = x - 13.0f + 20.0f * anim;
        float timeY = y + 5.5f;

        if (pvpTimeAnimation == null) {
            pvpTimeAnimation = new AnimatedNumber(Fonts.MEDIUM.getFont(6), 5.0f, 500L, Easing.BAKEK);
        }

        pvpTimeAnimation.settings(true, ColorRGBA.WHITE);
        pvpTimeAnimation.update(safeSeconds);

        float timeWidth = pvpTimeAnimation.getWidth() + timeFont.width(suffix);
        float rectWidth = 5.5f + timeWidth;

        drawRoundedRectForced(ctx, x - 16.0f + 20.0f * anim, y + 3.5f, rectWidth, 8.0f, BorderRadius.all(3.0f), color.mulAlpha(anim));

        pvpTimeAnimation.settings(true, ColorRGBA.WHITE.mulAlpha(anim));
        pvpTimeAnimation.pos(timeX, timeY);
        pvpTimeAnimation.render(ctx);

        ctx.drawText(timeFont, suffix, timeX + pvpTimeAnimation.getWidth(), timeY, ColorRGBA.WHITE.mulAlpha(anim));
        ctx.drawText(textFont, text, x + 23.0f - 10.0f * anim + timeWidth, y + 5.5f, Colors.getTextColor().mulAlpha(anim));
    }

    /**
     * Отрисовка музыкального статуса (плеер, обложка, управление, лирика).
     */
    private void drawMusicStatus(CustomDrawContext ctx, float x, float y, float anim) {
        if (!canShowMusicStatus() || activeSession == null) return;
        MediaInfo media = activeSession.getMedia();
        if (media == null) return;

        float extending = extendingAnim.getValue();
        float expWidth = 164.0f;          // TODO ширина развёрнутого плеера (было 164, щас хз)
        float expHeight = showLyrics ? 125.0f : 80.0f;  // TODO высота с/без текста
        float defaultWidth = 32.0f + Fonts.MEDIUM.getFont(7.0f).width(trackName);
        ColorRGBA textColor = Colors.getTextColor().mulAlpha(anim);

        float imageMargin = 4.0f + 6.0f * extending;    // TODO отступ картинки при развороте
        float imageSize = 7.0f + 19.0f * extending;     // TODO размер обложки (мин/макс)
        float imageY = y + (extended ? imageMargin : getMiddleOfBox(imageSize, this.height));
        Identifier trackImage = coverTexture != null ? artwork : Zenith.id("icons/music/no_image.png");

        DrawUtil.drawRoundedTexture(ctx.getMatrices(), trackImage, x + imageMargin - 10.0f + 10.0f * anim, imageY,
                imageSize, imageSize, BorderRadius.all(1.0f + 5.0f * extending), ColorRGBA.WHITE.mulAlpha(anim));

        float titleX = x - 5.0f + 10.0f * anim + 10.0f * anim + 29.0f * extending;

        float waveStartX = x + zenith.zov.utility.math.MathUtil.interpolate(
                Math.min(defaultWidth, 100f),
                expWidth - 10.0f,
                extending
        ) - 20.0f;

        float titleMaxWidth = waveStartX - titleX - 4.0f;
        if (titleMaxWidth < 20.0f) titleMaxWidth = 20.0f;

        float maxWidthCompact = 100.0f;
        float fadeWidthTitle = extended ? (expWidth - 30.0f) : (maxWidthCompact + 5.0f);
        fadeWidthTitle = Math.min(fadeWidthTitle, titleMaxWidth);

        drawFadeoutText(
                ctx,
                Fonts.MEDIUM.getFont(7.0f),
                media.getTitle(),
                titleX,
                y + 5.0f + 11.0f * extending,
                textColor.mulAlpha(0.85f), // TODO альфа названия песни
                fadeWidthTitle,
                0.3f, 1.25f
        );

        if (extending > 0.0f) {
            float fadeWidthArtist = extended ? (expWidth - 30.0f) : (maxWidthCompact + 5.0f);
            fadeWidthArtist = Math.min(fadeWidthArtist, titleMaxWidth);

            // Быстро гасим артиста + доп. гашение при нехватке места (чтобы не "налезал" на title)
            float cramped = 1f;
            if (fadeWidthArtist < 45f) cramped = clamp01((fadeWidthArtist - 20f) / 25f);
            float artistA = artistAlphaAnim.getValue() * extending * (0.15f + 0.85f * cramped);

            drawFadeoutText(
                    ctx,
                    Fonts.REGULAR.getFont(7.0f),
                    media.getArtist(),
                    x + 20.0f + 24.0f * extending,
                    y + 5.0f + 19.0f * extending,
                    textColor.mulAlpha(0.55f * artistA), // TODO альфа автора/артиста
                    fadeWidthArtist,
                    0.3f, 1.15f
            );

            // TODO Время и прогресс барчик
            String currentTimeText = formatMediaTime(currentTimeMs / 1000);
            String totalTimeText = formatMediaTime(totalTimeMs / 1000);

            ctx.drawText(Fonts.REGULAR.getFont(5.0f), currentTimeText,
                    mc.getWindow().getScaledWidth() / 2.0f - expWidth / 2.0f + 11.0f * extending,
                    y + 43.0f * extending,
                    textColor.mulAlpha(0.7f)); // TODO альфа времени песни (сколько прошло, например 1:05)

            ctx.drawText(Fonts.REGULAR.getFont(5.0f), totalTimeText,
                    mc.getWindow().getScaledWidth() / 2.0f + expWidth / 2.0f - (9.5f + Fonts.REGULAR.getFont(5.0f).width(totalTimeText) * extending),
                    y + 43.0f * extending,
                    textColor.mulAlpha(0.7f)); // TODO альфа времени песни (сколько всего идет)

            float barWidth = 116.0f;   // TODO ширина прогресс-бара
            float barX = mc.getWindow().getScaledWidth() / 2.0f - barWidth / 2.0f;
            float barY = y + expHeight - (showLyrics ? 45.0f : 0.0f) - 36.5f * extending;

            drawRoundedRectForced(ctx, barX, barY, barWidth, 3.0f, BorderRadius.all(0.5f), textColor.mulAlpha(0.25f)); // TODO пустая строка которая заполняется по мере... а поймешь крч
            float safeDuration = Math.max(1.0f, (float) totalTimeMs);
            float progressWidth = barWidth * Math.min(1.0f, (float) currentTimeMs / safeDuration);
            drawRoundedRectForced(ctx, barX, barY, progressWidth, 3.0f, BorderRadius.all(0.5f), textColor.mulAlpha(0.6f)); // TODO сама строка белая которая заполняет пустую строку

            if (extending > 0.7f) {
                float controlY = y + expHeight - 25.0f * extending;
                double mouseX = mc.mouse.getX() / mc.getWindow().getScaleFactor();
                double mouseY = mc.mouse.getY() / mc.getWindow().getScaleFactor();

                float buttonStartX = x + (expWidth - 16f * 3 - 16f) / 2f;
                float previousX = buttonStartX;
                float pauseX = previousX + 24f;
                float nextX = pauseX + 24f;

                zenith.zov.utility.render.display.base.Rect previous = new zenith.zov.utility.render.display.base.Rect(previousX, controlY, 16.0f, 16.0f);
                zenith.zov.utility.render.display.base.Rect pause = new zenith.zov.utility.render.display.base.Rect(pauseX, controlY, 16.0f, 16.0f);
                zenith.zov.utility.render.display.base.Rect next = new zenith.zov.utility.render.display.base.Rect(nextX, controlY, 16.0f, 16.0f);

                hoverPrevious.update(previous.contains(mouseX, mouseY));
                hoverPause.update(pause.contains(mouseX, mouseY));
                hoverNext.update(next.contains(mouseX, mouseY));

                // anti-pixel: включаем linear filtering (с ассетами 32x32 будет заметно лучше)
                setLinearTextureFiltering(true);

                ctx.drawTexture(Zenith.id("icons/music/previous.png"), previous.x(), previous.y(), previous.width(), previous.height(),
                        textColor.mulAlpha(1.0f - 0.4f * hoverPrevious.getValue()));

                float pauseAnim = pausingAnim.getValue();
                float centerX = pause.x() + pause.width() / 2.0f;
                float centerY = pause.y() + pause.height() / 2.0f;

                drawRotatedScaledTexture(ctx, Zenith.id("icons/music/play.png"), pause.x(), pause.y(), pause.width(), pause.height(),
                        centerX, centerY, 90.0f * pauseAnim, Math.max(0.001f, 1.0f - pauseAnim),
                        textColor.mulAlpha((1.0f - pauseAnim) * (1.0f - 0.4f * hoverPause.getValue())));

                drawRotatedScaledTexture(ctx, Zenith.id("icons/music/pause.png"), pause.x(), pause.y(), pause.width(), pause.height(),
                        centerX, centerY, -90.0f + 90.0f * pauseAnim, Math.max(0.001f, pauseAnim),
                        textColor.mulAlpha(pauseAnim * (1.0f - 0.4f * hoverPause.getValue())));

                ctx.drawTexture(Zenith.id("icons/music/next.png"), next.x(), next.y(), next.width(), next.height(),
                        textColor.mulAlpha(1.0f - 0.4f * hoverNext.getValue()));

                setLinearTextureFiltering(false);
            }

            String ownerIcon = resolveOwnerIcon(activeSession.getOwner());
            if (ownerIcon != null) {
                ctx.drawTexture(Zenith.id("icons/media/" + ownerIcon + ".png"), x + expWidth - 22.0f, y + expHeight - 21.0f, 8.0f, 8.0f, ColorRGBA.WHITE.mulAlpha(anim));
            }

            // кнопка "lyrics" показывается если есть текст (synced или unsynced)
            if (!timedLyrics.isEmpty()) {
                zenith.zov.utility.render.display.base.Rect lyricsRect =
                        new zenith.zov.utility.render.display.base.Rect(x + 14.0f, y + expHeight - 21.0f, 8.0f, 8.0f);

                double mouseX = mc.mouse.getX() / mc.getWindow().getScaleFactor();
                double mouseY = mc.mouse.getY() / mc.getWindow().getScaleFactor();
                hoverLyrics.update(lyricsRect.contains(mouseX, mouseY));

                setLinearTextureFiltering(true);
                ctx.drawTexture(Zenith.id("icons/music/text.png"), lyricsRect.x(), lyricsRect.y(), lyricsRect.width(), lyricsRect.height(),
                        textColor.mulAlpha(1.0f - 0.4f * hoverLyrics.getValue()));
                setLinearTextureFiltering(false);
            }

            // ===== Лирика (текст песни) с вертикальным затенением =====
            if (showLyrics && !timedLyrics.isEmpty()) {
                float lyricAreaWidth = expWidth - 20.0f;
                float baseY = y + 55.0f;
                float areaTop = baseY - 1.0f;
                float areaBottom = baseY + (6 * LYRIC_LINE_HEIGHT) + 1.0f;
                float fadeZone = LYRIC_LINE_HEIGHT * 1.6f;

                if (lyricsSynced) {
                    int centerIndex = lyricsAnimating ? targetLyricIndex : currentLyricIndex;

                    // Окно фиксируем на старом индексе во время анимации, чтобы не было дерганья
                    int baseIndex = (lyricsAnimating && lyricsWindowBaseIndex != -1) ? lyricsWindowBaseIndex : centerIndex;

                    int start = computeSyncedWindowStart(baseIndex, timedLyrics.size());
                    int end = Math.min(timedLyrics.size(), start + 6);

                    for (int i = start; i < end; i++) {
                        String line = timedLyrics.get(i).text;

                        // если centerIndex == -1 (еще не дошли до 1й строки) — не подсвечиваем
                        boolean isActive = (centerIndex >= 0 && i == centerIndex);
                        int diff = (centerIndex >= 0) ? Math.abs(i - centerIndex) : 999;

                        ColorRGBA lineColor;
                        if (isActive) lineColor = textColor;
                        else if (diff == 1) lineColor = textColor.withAlpha(70);
                        else lineColor = textColor.withAlpha(40);

                        float yOffset = baseY + (i - start) * LYRIC_LINE_HEIGHT + lyricsCurrentShift;
                        Font lyricFont = isActive ? Fonts.REGULAR.getFont(6.18f) : Fonts.REGULAR.getFont(5.5f);
                        String truncated = truncateToWidth(line, lyricAreaWidth, lyricFont);

                        float aMul = 1.0f;
                        if (yOffset < areaTop + fadeZone) {
                            float t = (yOffset - areaTop) / fadeZone;
                            aMul = clamp01(t);
                        } else if (yOffset > areaBottom - fadeZone) {
                            float t = (areaBottom - yOffset) / fadeZone;
                            aMul = clamp01(t);
                        }
                        aMul = 0.25f + 0.75f * aMul;

                        ctx.drawText(lyricFont, truncated, x + 10.0f, yOffset, lineColor.mulAlpha(extending * aMul));
                    }
                } else {
                    renderUnsyncedLyrics(ctx, x, y, expWidth, extending, textColor, areaTop, areaBottom, fadeZone);
                }
            }
        }

        // Волны (визуализация звука)
        for (int i = 0; i < waveAnims.length; i++) {
            float phase = (float) (currentTimeMs / 1000.0 * 8.0) + i * 0.7f;
            float size = isPlaying ? (float) (2.0 + Math.abs(zenith.zov.utility.math.MathUtil.sin(phase)) * 8.0) : 3.0f;
            waveAnims[i].update(size);

            drawRoundedRectForced(ctx,
                    x + zenith.zov.utility.math.MathUtil.interpolate(Math.min(defaultWidth, 100f), expWidth - 10.0f, extending)
                            - 2.0f - 10.0f * anim + i * (2.0f + extending),
                    y + zenith.zov.utility.math.MathUtil.interpolate(4.25, 14.0, extending) + (7.0f - waveAnims[i].getValue()) / 2.0f,
                    1.0f + extending, waveAnims[i].getValue(),
                    BorderRadius.all(0.5f),
                    mediaColor.mulAlpha(anim));
        }
    }

    private int computeSyncedWindowStart(int centerIndex, int totalLines) {
        if (totalLines <= 6) return 0;
        if (centerIndex < 0) return 0;
        int start = centerIndex - 2;
        int maxStart = totalLines - 6;
        if (start < 0) start = 0;
        if (start > maxStart) start = maxStart;
        return start;
    }

    private void renderUnsyncedLyrics(CustomDrawContext ctx, float x, float y, float expWidth, float extending,
                                      ColorRGBA textColor, float areaTop, float areaBottom, float fadeZone) {
        float lyricAreaWidth = expWidth - 20.0f;
        float baseY = y + 55.0f;

        int maxStart = Math.max(0, timedLyrics.size() - UNSYNC_VISIBLE_LINES);
        if (lyricsScrollIndex > maxStart) lyricsScrollIndex = maxStart;
        if (lyricsScrollIndex < 0) lyricsScrollIndex = 0;

        Font lyricFont = Fonts.REGULAR.getFont(UNSYNC_FONT_SIZE);
        ColorRGBA baseColor = textColor.withAlpha(UNSYNC_ALPHA).mulAlpha(extending);

        int start = lyricsScrollIndex;
        int end = Math.min(timedLyrics.size(), start + UNSYNC_VISIBLE_LINES);

        for (int i = start; i < end; i++) {
            String line = timedLyrics.get(i).text;
            String truncated = truncateToWidth(line, lyricAreaWidth, lyricFont);
            float yOffset = baseY + (i - start) * LYRIC_LINE_HEIGHT;

            float aMul = 1.0f;
            if (yOffset < areaTop + fadeZone) {
                float t = (yOffset - areaTop) / fadeZone;
                aMul = clamp01(t);
            } else if (yOffset > areaBottom - fadeZone) {
                float t = (areaBottom - yOffset) / fadeZone;
                aMul = clamp01(t);
            }
            aMul = 0.25f + 0.75f * aMul;

            ctx.drawText(lyricFont, truncated, x + 10.0f, yOffset, baseColor.mulAlpha(aMul));
        }
    }

    private float clamp01(float v) {
        return Math.max(0f, Math.min(1f, v));
    }

    /**
     * Обработка скролла мыши (для несинхронной лирики).
     */
    public boolean handleMouseScroll(double mouseX, double mouseY, double verticalAmount) {
        if (!extended || activeStatus != StatusType.MUSIC) return false;
        if (!showLyrics || timedLyrics.isEmpty()) return false;
        if (lyricsSynced) return false;

        if (!isMouseOver((float) mouseX, (float) mouseY)) return false;

        int delta = verticalAmount > 0 ? -UNSYNC_SCROLL_STEP : UNSYNC_SCROLL_STEP;
        lyricsScrollIndex += delta;

        int maxStart = Math.max(0, timedLyrics.size() - UNSYNC_VISIBLE_LINES);
        if (lyricsScrollIndex > maxStart) lyricsScrollIndex = maxStart;
        if (lyricsScrollIndex < 0) lyricsScrollIndex = 0;

        return true;
    }

    private void drawRotatedScaledTexture(CustomDrawContext ctx, Identifier id, float x, float y, float width, float height,
                                          float centerX, float centerY, float degrees, float scale, ColorRGBA color) {
        MatrixStack matrices = ctx.getMatrices();
        matrices.push();
        matrices.translate(centerX, centerY, 0.0f);
        matrices.multiply(RotationAxis.POSITIVE_Z.rotationDegrees(degrees));
        matrices.scale(scale, scale, 1.0f);
        matrices.translate(-centerX, -centerY, 0.0f);
        ctx.drawTexture(id, x, y, width, height, color);
        matrices.pop();
    }

    private void drawFadeoutText(CustomDrawContext ctx, Font font, String text, float x, float y,
                                 ColorRGBA color, float maxWidth, float fadeStart, float fadeEnd) {
        if (text == null || text.isEmpty()) return;

        float textWidth = font.width(text);
        if (textWidth <= maxWidth) {
            ctx.drawText(font, text, x, y, color);
            return;
        }

        MsdfRenderer.renderText(
                font.getFont(), text, font.getSize(), color.getRGB(),
                ctx.getMatrices().peek().getPositionMatrix(), x, y, 0,
                true, fadeStart, fadeEnd, maxWidth
        );
    }

